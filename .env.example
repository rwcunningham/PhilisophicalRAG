# Copy this file to .env, then paste your OpenAI API key below.
# Do not commit .env.
OPENAI_API_KEY=sk-your-key-here

# Defaults chosen for a citation-heavy RAG assistant. You can change these later.
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Optional local paths.
PHILOSOPHY_RAG_CORPUS=data/texts
PHILOSOPHY_RAG_INDEX=data/index/chroma
